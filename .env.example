# Find both values in the Supabase project Connect panel. The publishable key
# is safe to include in a client build; never put a Supabase secret/service-role
# key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
