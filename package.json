{
  "name": "ascend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor",
    "check": "npm run typecheck && npm run doctor",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "generate:music": "node scripts/generate-music.mjs",
    "slice:icons": "node scripts/slice-icon-atlases.mjs",
    "export:web": "expo export --platform web",
    "verify:release": "npm run check && expo export --platform all",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "build:development:ios": "npx eas-cli build --platform ios --profile development",
    "build:production": "npx eas-cli build --profile production --platform all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
